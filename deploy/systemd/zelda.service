[Unit]
Description=Z.E.L.D.A. AI Control Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=-%h/.config/zelda/zelda.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/zelda-daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
