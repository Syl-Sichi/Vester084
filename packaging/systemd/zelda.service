[Unit]
Description=Z.E.L.D.A. Ubuntu AI Control Service
Documentation=https://github.com/Syl-Sichi/Vester084
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zelda
Group=zelda
WorkingDirectory=/opt/zelda
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m zelda.daemon
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
